import procesImg from "./proces.png";

export class GraphRenderer {
  constructor() {
    this.svg = null;
    this.graph = null;
    (this.d3 = null), (this.selectedProcesId = null);
    this.selectedChannelId = null;
    this.handleProcesClick = null;
    this.handleChannelClick = null;
  }

  init({
    svg,
    graph,
    d3,
    selectedProcesId,
    selectedChannelId,
    handleProcesClick,
    handleChannelClick,
  }) {
    this.svg = svg;
    this.graph = graph;
    this.d3 = d3;
    this.selectedProcesId = selectedProcesId;
    this.selectedChannelId = selectedChannelId;
    this.handleProcesClick = handleProcesClick;
    this.handleChannelClick = handleChannelClick;

    this.svg
      .append("defs")
      .append("marker")
      .attr("id", "channel")
      .attr("viewBox", "0 0 10 10")
      .attr("refX", "10")
      .attr("refY", "5")
      .attr("markerWidth", "6")
      .attr("markerHeight", "6")
      .attr("orient", "auto-start-reverse")
      .append("path")
      .attr("d", "M 0 0 L 10 5 L 0 10 z")
      .attr("fill", "black");
  }

  render() {
    const svg = this.svg;
    const graph = this.graph;
    const selectedProcesId = this.selectedProcesId.value;
    const selectedChannelId = this.selectedChannelId.value;
    const handleProcesClick = this.handleProcesClick;

    const defs = {
      svg,
      graph,
      selectedChannelId,
      selectedProcesId,
      handleProcesClick,
    };

    this.drawChannels(defs);
    this.drawProcesses(defs);
  }

  // =======================
  // DRAW process
  // =======================

  renderChannelName(channel) {
    return channel.proces1.id + "-" + channel.proces2.id;
  }

  drawProcesses(defs) {
    const { svg, graph, selectedProcesId, handleProcesClick } = defs;
    const drag = this.d3.drag().on("drag", (channel, d) => {
      d.x = channel.x;
      d.y = channel.y;
      this.render();
    });

    const groups = svg
      .selectAll("g.proces")
      .data(graph.processes, (d) => d.id)
      .join("g")
      .attr("class", "proces")
      .attr("transform", (d) => `translate(${d.x}, ${d.y})`)
      .call(drag)
      .on("click", handleProcesClick);

    // circle (main)
    groups
      .selectAll("circle.inner")
      .data((d) => [d])
      .join("circle")
      .attr("class", "inner")
      .attr("r", (d) => (d.isStart ? d.r - 5 : d.r))
      .attr("fill", (d) => (d.id === selectedProcesId ? "orange" : "white"))
      .attr("stroke", "black")
      .attr("stroke-width", 2)
      .style("cursor", "pointer");

    svg.selectAll("text.proces-label").remove();

    groups
      .selectAll("image.node-icon")
      .data((d) => [d])
      .join("image")
      .attr("class", "node-icon")
      .attr("href", procesImg)
      .attr("x", (d) => -d.r) // position relative to group center
      .attr("y", (d) => -d.r)
      .attr("width", (d) => d.r * 2) // size matches circle diameter
      .attr("height", (d) => d.r * 2)
      .style("cursor", "pointer");

    svg
      .selectAll("rect.proces-label-bg")
      .data(graph.processes)
      .join("rect")
      .attr("class", "proces-label-bg")
      .attr("x", (d) => d.x - (d.label.length * 8 + 10) / 2) // center behind text
      .attr("y", (d) => d.y + d.r + 18 - 16) // align with text vertically
      .attr("width", (d) => d.label.length * 8 + 10) // dynamic width
      .attr("height", 20) // fixed height
      .attr("fill", "white")
      .attr("stroke", "black")
      .attr("stroke-width", 1)
      .attr("rx", 4) // rounded corners
      .raise();

    // proces labels
    svg
      .selectAll("text.proces-label")
      .data(graph.processes)
      .join("text")
      .attr("class", "proces-label")
      .attr("x", (d) => d.x)
      .attr("y", (d) => d.y + d.r + 18)
      .attr("text-anchor", "middle")
      .attr("font-size", 16)
      .attr("fill", "black")
      .style("pointer-channels", "none") // allow dragging background later
      .text((d) => d.label);
  }

  // =======================
  // DRAW channels
  // =======================

  drawChannels(defs) {
    const { svg, graph, selectedChannelId } = defs;
    svg.selectAll("path.channel").remove();
    svg.selectAll("circle.ctrl").remove();
    svg.selectAll("rect.channel-label-bg").remove();
    svg.selectAll("text.channel-label").remove();

    graph.channels.forEach((channel) => {
      const c1 = graph.processes.find((n) => n.id === channel.proces1.id);
      const c2 = graph.processes.find((n) => n.id === channel.proces2.id);
      if (!c1 || !c2 || !channel.ctrl) return;

      let d;

      if (channel.proces1.id === channel.proces2.id) {
        // --- self-loop ---
        const dx = channel.ctrl.x - c1.x;
        const dy = channel.ctrl.y - c1.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const angle = Math.atan2(dy, dx);
        const angleOffset = Math.PI / 4; // ±45°

        // compute loop control points
        channel._ctrl1 = {
          x: c1.x + dist * Math.cos(angle - angleOffset),
          y: c1.y + dist * Math.sin(angle - angleOffset),
        };
        channel._ctrl2 = {
          x: c1.x + dist * Math.cos(angle + angleOffset),
          y: c1.y + dist * Math.sin(angle + angleOffset),
        };

        channel._start = this.getBorderPoint(c1, channel._ctrl1, c1.r);
        channel._end = this.getBorderPoint(c1, channel._ctrl2, c1.r);
        channel._mid = this.getCubicBezierMidpoint(
          channel._start,
          channel._ctrl1,
          channel._ctrl2,
          channel._end,
          0.5
        );

        d = `M${channel._start.x},${channel._start.y} C${channel._ctrl1.x},${channel._ctrl1.y} ${channel._ctrl2.x},${channel._ctrl2.y} ${channel._end.x},${channel._end.y}`;
      } else {
        // --- normal channel ---
        channel._start = this.getBorderPoint(c1, channel.ctrl, c1.r);
        channel._end = this.getBorderPoint(c2, channel.ctrl, c2.r);
        channel._ctrl = this.getStretchedCtrl(c1, c2, channel.ctrl);
        channel._mid = this.getQuadraticBezierMidpoint(
          channel._start,
          channel._ctrl,
          channel._end,
          0.5
        );

        d = `M${channel._start.x},${channel._start.y} Q${channel._ctrl.x},${channel._ctrl.y} ${channel._end.x},${channel._end.y}`;
      }

      svg
        .append("path")
        .attr("class", "channel")
        .attr("d", d)
        .attr("stroke", channel.id === selectedChannelId ? "orange" : "black")
        .attr("stroke-width", 1)
        .attr("fill", "none")
        .style("cursor", "pointer")
        .on("click", (domEvent) => {
          this.handleChannelClick(domEvent, channel.id);
        });
    });

    svg
      .selectAll("rect.channel-label-bg")
      .data(graph.channels)
      .join("rect")
      .attr("class", "channel-label-bg")
      .attr("x", (d) => {
        if (!d._mid) return 0;
        const width = this.renderChannelName(d).length * 8 + 10;
        return d._mid.x - width / 2; // center rect on curve midpoint
      })
      .attr("y", (d) => {
        if (!d._mid) return 0;
        return d._mid.y - 12; // vertical offset
      })
      .attr("width", (d) => this.renderChannelName(d).length * 8 + 10)
      .attr("height", 20)
      .attr("fill", "white")
      .attr("stroke", "black")
      .attr("stroke-width", 1)
      .attr("rx", 4)
      .style("cursor", "pointer")
      .on("click", (domEvent, d) => {
        this.handleChannelClick(domEvent, d.id);
      });

    svg
      .selectAll("text.channel-label")
      .data(graph.channels)
      .join("text")
      .attr("class", "channel-label")
      .attr("x", (d) => (d._mid ? d._mid.x : 0))
      .attr("y", (d) => (d._mid ? d._mid.y + 4 : 0)) // vertical offset for visual centering
      .attr("text-anchor", "middle")
      .attr("font-size", 14)
      .attr("fill", "black")
      .text((d) => this.renderChannelName(d))
      .style("cursor", "pointer")
      .on("click", (domEvent, d) => {
        this.handleChannelClick(domEvent, d.id);
      });

    graph.channels.forEach(({ ctrl, id }, i) => {
      if (id === selectedChannelId) {
        svg
          .append("circle")
          .attr("class", "ctrl")
          .attr("cx", ctrl.x)
          .attr("cy", ctrl.y)
          .attr("r", 8)
          .attr("fill", "orange")
          .call(
            this.d3.drag().on("drag", (channel) => {
              ctrl.x = channel.x;
              ctrl.y = channel.y;
              this.render();
            })
          );
      }
    });
  }

  getBorderPoint(from, to, r) {
    const dx = to.x - from.x;
    const dy = to.y - from.y;
    const len = Math.sqrt(dx * dx + dy * dy);
    if (len === 0) return { x: from.x, y: from.y };
    return {
      x: from.x + (dx * r) / len,
      y: from.y + (dy * r) / len,
    };
  }

  getQuadraticBezierMidpoint(P0, P1, P2) {
    return {
      x: (P0.x + 2 * P1.x + P2.x) / 4,
      y: (P0.y + 2 * P1.y + P2.y) / 4,
    };
  }
  getCubicBezierMidpoint(p0, p1, p2, p3) {
    const t = 0.5;
    const x =
      Math.pow(1 - t, 3) * p0.x +
      3 * Math.pow(1 - t, 2) * t * p1.x +
      3 * (1 - t) * t * t * p2.x +
      t * t * t * p3.x;
    const y =
      Math.pow(1 - t, 3) * p0.y +
      3 * Math.pow(1 - t, 2) * t * p1.y +
      3 * (1 - t) * t * t * p2.y +
      t * t * t * p3.y;
    return { x, y };
  }

  getLoopCtrl(c1, c2, ctrl) {
    // Midpoint between processes
    const mid = { x: (c1.x + c2.x) / 2, y: (c1.y + c2.y) / 2 };

    // Vector defined by ctrl relative to center (size + direction)
    const dx = ctrl.x - c1.x;
    const dy = ctrl.y - c1.y;

    // Length of vector = size of curve
    const len = Math.sqrt(dx * dx + dy * dy);

    // Direction = angle of vector
    const angle = Math.atan2(dy, dx);

    // Scale how "strong" the bend should be
    const strength = 1.0;

    return {
      x: mid.x + Math.cos(angle) * len * strength,
      y: mid.y + Math.sin(angle) * len * strength,
    };
  }

  getStretchedCtrl(c1, c2, ctrl) {
    const mid = { x: (c1.x + c2.x) / 2, y: (c1.y + c2.y) / 2 };

    const dx = ctrl.x - mid.x;
    const dy = ctrl.y - mid.y;

    const factor = 1.0; // adjust bend strength

    return {
      x: mid.x + dx * factor, // horizontal movement → horizontal bend
      y: mid.y + dy * factor, // vertical movement → vertical bend
    };
  }
}

{
  "appId": "com.example.lpa",
  "productName": "LPA",
  "directories": {
    "buildResources": "build",
    "output": "dist_electron"
  },
  "files": [
    "dist/**",
    "vue/dist/**",
    "electron/main/**",
    "electron/preload/**",
    "package.json"
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/logo.icns"
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "assets/logo.ico"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "assets/logo.png"
  }
}
